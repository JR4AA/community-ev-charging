# Copy to /etc/evcharge/env (mode 600) and fill in. Everything except the PayPal
# keys is optional; the comments give the defaults.

# --- PayPal (docs/paypal.md) -------------------------------------------------
PAYPAL_ENV=sandbox                  # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=                  # from the webhook registered on the PayPal app
PAYMENT_METHODS=card                # card: guest card checkout only (1.2% + 30p in the UK)
                                    # all:  PayPal accounts as well (2.9% + 30p)
# CURRENCY=GBP
# INVOICE_PREFIX=EV-                # PayPal invoice ids are this + the session id
PUBLIC_URL=https://ev.example.org   # puts the driver's session link in the PayPal description

# --- Prices -------------------------------------------------------------------
# Time-of-use bands in local time, covering the whole day, "name HH:MM-HH:MM price".
# Each kWh is priced at the band in force when it was delivered.
TARIFF=offpeak 00:00-16:00 0.27; peak 16:00-19:00 0.46; offpeak 19:00-24:00 0.27
# PRICE_PER_KWH=0.45                # a flat price instead of TARIFF
SESSION_FEE=0.30                    # added to any charge that delivers energy
# SOLAR_PRICE_PER_KWH=0.05          # replaces the band while the solar flag is on
                                    # (python -m evcharge.cli solar on|off)

# --- Holds --------------------------------------------------------------------
HOLD_OPTIONS=60,40,20               # amounts the driver can choose, in display order
HOLD_DEFAULT=40                     # preselected (default: the first)
# UNUSED_AUTH_MINUTES=15            # release a hold nobody starts charging on
# STOP_MARGIN=0.50                  # stop the charger this close to the hold

# --- Sockets and the charger (docs/ocpp.md) ------------------------------------
# CONNECTORS=CP1,CP2                # socket names, as used in /pay/<socket>
# SOCKETS=CP1=CP1:1,CP2=CP2:1       # socket = OCPP charge point id : connector id
                                    # one charge point, two connectors: CP1=MYCP:1,CP2=MYCP:2
# OCPP_PORT=9000
# OCPP_PASSWORD_CP1=                # HTTP Basic password for charge point CP1; required
# OCPP_PASSWORD_CP2=                # for connections through the tunnel
# OCPP_ALLOW_WS_CP1=true            # plain ws:// on the LAN, only for a charger that can't do wss://
SOCKET_KW_CP1=22                    # shown beside the socket name
SOCKET_SHARES_CP1=CP2               # "22 kW (shared with CP2)"
SOCKET_KW_CP2=22
SOCKET_SHARES_CP2=CP1

# --- Admin (http://<OCPP_BIND>:8081/admin, your LAN only) ------------------------
# ADMIN_PASSWORD=                   # unset: no admin pages. Any user name, this password.
# API_TOKEN=                        # Bearer token for /api/status (Home Assistant; docs/home-assistant.md)
# STOP_MARGIN_WH=300                # stop kWh-limited free charges this close to the limit

# --- Branding (all optional; unset, the pages are plain) -----------------------
# BRAND_NAME=St Example's Church    # page header; also the name PayPal shows
# BRAND_LOGO=logo.png               # a file in /etc/evcharge/brand/; also the tab icon
# BRAND_COLOR=#1f5f7a               # accent: header band, selected hold
# FOOTER_TEXT=St Example's Church, registered charity 1234567.
# PAGE_NOTE=First paragraph.\n\nSecond paragraph.
# SUPPORT_CONTACT=Please call the church office on 01234 567890.
